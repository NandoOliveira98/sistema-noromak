# Agente de imagens do Noromak (V20.17) — copie este arquivo para config.env e preencha.
# O config.env NUNCA vai para o Git (.gitignore). A chave da API fica só neste PC.

# Chave da API do Claude (console.anthropic.com > API Keys). Cole você mesmo; não mande pelo chat.
ANTHROPIC_API_KEY=

# Endereço do Noromak (produção). Para testar no PC: http://127.0.0.1:8100/expedicao
NOROMAK_URL=https://noromakweb.com.br/expedicao

# Token do agente: Noromak > Imagens > (perfil Admin) GET /expedicao/api/imagens/agente/config
NOROMAK_AGENTE_TOKEN=

# Pasta do Real-ESRGAN (já instalado com a skill imagem-anuncio). Deixe vazio para o padrão.
# REALESRGAN_DIR=C:\Users\user40\.claude\skills\imagem-anuncio\ferramentas\realesrgan

# Tunel SSH ate a VPS: o portao de login do NoromakWeb no nginx barra o agente pelo endereco publico.
# Com o nome do host do ~/.ssh/config (o mesmo da publicacao), o agente fala com a Expedicao por dentro da VPS.
# Vazio = endereco publico (quando liberarem /expedicao/api/imagens/agente/ no nginx).
NOROMAK_TUNEL=expedicao
