[Unit]
Description=Sistema de Conferencia e Expedicao Noromak
Wants=network-online.target
After=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
User=expedicao
Group=expedicao
WorkingDirectory=/home/expedicao/app
EnvironmentFile=-/home/expedicao/.env
ExecStart=/home/expedicao/app/expedicao
Restart=always
RestartSec=3
MemoryMax=250M
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
