# Exemplo. Segredos reais devem ficar somente em /home/expedicao/.env.
EXP_ADMIN_USUARIO=luis
# Não existem mais senhas padrão no código. Se estas variáveis forem omitidas numa
# instalação nova, o sistema gera senha aleatória e grava uma única vez em:
# /home/expedicao/dados/CREDENCIAIS_INICIAIS.txt (permissão 600).
# EXP_ADMIN_SENHA=defina-uma-senha-forte-se-necessario
# EXP_USUARIO_SENHA_INICIAL=defina-uma-senha-forte-se-necessario
# A conta genérica "admin" não é criada por padrão.
EXP_SEED_GENERIC_ADMIN=0
EXP_HOST=127.0.0.1
EXP_PORT=8100
EXP_DB_PATH=/home/expedicao/dados/expedicao.db
EXP_BACKUP_DIR=/home/expedicao/backups
EXP_SESSION_TTL_SECONDS=43200
EXP_STATION_SESSION_TTL_SECONDS=15552000
