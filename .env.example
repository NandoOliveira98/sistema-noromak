# Exemplo. Segredos reais devem ficar somente em /home/expedicao/.env.
EXP_ADMIN_USUARIO=luis
# Defina uma senha forte. Se ficar vazio em uma instalação nova, o sistema
# gera uma senha aleatória em /home/expedicao/dados/CREDENCIAIS_INICIAIS.txt.
EXP_ADMIN_SENHA=
# Opcional, usado apenas ao migrar operadores antigos sem senha definida.
EXP_USUARIO_SENHA_INICIAL=
EXP_HOST=127.0.0.1
EXP_PORT=8100
EXP_DB_PATH=/home/expedicao/dados/expedicao.db
EXP_BACKUP_DIR=/home/expedicao/backups
# Sessão interna do estoque: 12 horas por padrão.
EXP_SESSION_TTL_SECONDS=43200
# Sessão dedicada da Estação Zebra: 180 dias, renovada enquanto estiver online.
EXP_STATION_SESSION_TTL_SECONDS=15552000


# Mercado Livre API — preencher no servidor após criar o aplicativo no DevCenter.
# NUNCA versionar o Client Secret real.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://noromakweb.com.br/expedicao/api/integracoes/mercadolivre/callback
ML_NOTIFICATION_URL=https://noromakweb.com.br/expedicao/api/integracoes/mercadolivre/notificacoes
ML_OAUTH_SCOPE=offline_access read write
ML_HTTP_TIMEOUT=20
ML_MANUAL_SYNC_LIMIT=20

# V16.0 — sincronização Mercado Livre 24/7 no servidor.
# Essas rotinas continuam funcionando mesmo com o navegador e PCs da empresa fechados.
ML_NEW_ORDER_WATCH_INTERVAL=20
ML_NEW_ORDER_WATCH_LIMIT=20
ML_PENDING_WATCH_INTERVAL=15
ML_MANUAL_RECONCILE_INTERVAL=60
ML_TOKEN_KEEPALIVE_INTERVAL=300
ML_TOKEN_REFRESH_AHEAD_SECONDS=1800
ML_SAFETY_CATCHUP_INTERVAL=900
ML_SAFETY_CATCHUP_HOURS=36

# Fase 1 - segurança e backups
EXP_BACKUP_RETENTION_DAYS=30
# Recomendado: após criar o administrador, remova EXP_ADMIN_SENHA do .env.
