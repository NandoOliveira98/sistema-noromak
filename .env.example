# Exemplo. Segredos reais devem ficar somente em /home/expedicao/.env.
EXP_ADMIN_USUARIO=luis
# Defina uma senha forte. Se ficar vazio em uma instalação nova, o sistema
# gera uma senha aleatória em /home/expedicao/dados/CREDENCIAIS_INICIAIS.txt.
EXP_ADMIN_SENHA=
# Opcional, usado apenas ao migrar operadores antigos sem senha definida.
EXP_USUARIO_SENHA_INICIAL=
EXP_HOST=127.0.0.1
EXP_PORT=8100
EXP_DB_PATH=/home/expedicao/dados/expedicao.db
EXP_BACKUP_DIR=/home/expedicao/backups
# Sessão interna do estoque: 12 horas por padrão.
EXP_SESSION_TTL_SECONDS=43200
# Sessão dedicada da Estação Zebra: 180 dias, renovada enquanto estiver online.
EXP_STATION_SESSION_TTL_SECONDS=15552000


# Mercado Livre API — preencher no servidor após criar o aplicativo no DevCenter.
# NUNCA versionar o Client Secret real.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://noromakweb.com.br/expedicao/api/integracoes/mercadolivre/callback
ML_NOTIFICATION_URL=https://noromakweb.com.br/expedicao/api/integracoes/mercadolivre/notificacoes
ML_OAUTH_SCOPE=offline_access read write
ML_HTTP_TIMEOUT=20
ML_MANUAL_SYNC_LIMIT=20

# V16.0 — sincronização Mercado Livre 24/7 no servidor.
# Essas rotinas continuam funcionando mesmo com o navegador e PCs da empresa fechados.
ML_NEW_ORDER_WATCH_INTERVAL=20
ML_NEW_ORDER_WATCH_LIMIT=20
ML_PENDING_WATCH_INTERVAL=15
ML_MANUAL_RECONCILE_INTERVAL=60
ML_TOKEN_KEEPALIVE_INTERVAL=300
ML_TOKEN_REFRESH_AHEAD_SECONDS=1800
ML_SAFETY_CATCHUP_INTERVAL=900
ML_SAFETY_CATCHUP_HOURS=36

# Shopee Open Platform (preencher somente após aprovação Go-Live)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://noromakweb.com.br/expedicao/api/integracoes/shopee/callback
SHOPEE_AUTH_URL=
SHOPEE_API_BASE=

# Estoque disponível Apollo (Demanda Full, Precificador, Central). Se vazio, usa a
# rota irmã de CRM_COST_API_URL: .../expedicao/custo -> .../expedicao/estoque.
# Contrato: INTEGRACAO_ESTOQUE_APOLLO.md. Limite de 20 chamadas/min somado com /custo.
CRM_STOCK_API_URL=
CRM_STOCK_TIMEOUT=20

# V18.13 — Relatório diário de vendas por e-mail (agente às 00:01). Sem IA, sem
# dependência externa (usa smtplib). Deixe RELATORIO_EMAILS vazio para desligar.
RELATORIO_DIARIO_ATIVO=1
RELATORIO_EMAILS=            # destinatários separados por vírgula, ex.: luis@noromak.com.br,estoque@noromak.com.br
# SMTP do remetente. Para Gmail: host smtp.gmail.com porta 587, e uma "senha de app"
# (não a senha normal da conta) gerada em myaccount.google.com/apppasswords.
SMTP_HOST=                   # ex.: smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                   # ex.: relatorios.noromak@gmail.com
SMTP_SENHA=                  # senha de app (NUNCA versionar a real)
SMTP_FROM=                   # opcional; se vazio usa SMTP_USER
SMTP_TLS=1

# V18.52: login unico com o NoromakWeb. Mesmo valor que o portao do nginx manda em
# X-NoromakWeb-Segredo (minimo 32 caracteres). Vazio = desligado (so o login proprio).
NOROMAKWEB_SSO_SECRET=
